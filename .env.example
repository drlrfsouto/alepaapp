# ============================================================
# Variáveis de ambiente do deploy (Vercel: Settings → Environment Variables)
# NENHUMA delas vai para o navegador — só as funções de /api enxergam.
# Copie para .env se quiser testar localmente (o arquivo .env está no .gitignore).
# ============================================================

# --- IA: chaves GRATUITAS do Google AI Studio (https://aistudio.google.com/apikey) ---
# Várias chaves = contingência: se a primeira estourar a cota (429), o proxy usa a próxima.
# Os limites gratuitos são POR PROJETO, então crie uma chave em cada projeto diferente.
# Aceita vírgula, espaço ou quebra de linha como separador.
GEMINI_API_KEYS=AIzaSuaChave1,AIzaSuaChave2DeContingencia

# Alternativas equivalentes (use uma forma ou outra):
# GEMINI_API_KEY=AIzaSuaChave1
# GEMINI_API_KEY_2=AIzaSuaChave2
# GEMINI_API_KEY_3=AIzaSuaChave3

# Modelo padrão. Free tier em 2026: família Flash / Flash-Lite (os Pro são pagos).
# "gemini-flash-latest" é o apelido do Flash estável mais recente.
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Proteção do proxy
# Origens que podem chamar /api de outro domínio (vazio = só mesma origem).
# Ex.: ALLOWED_ORIGINS=https://alepaapp.vercel.app,https://*.vercel.app,http://localhost:8080
ALLOWED_ORIGINS=
IA_MAX_TOKENS=4096
IA_RATE_LIMIT=30
IA_TIMEOUT_MS=60000

# --- Supabase (opcional; usado pelo navegador, portanto valores PÚBLICOS) ---
# Se preferir, coloque estes dois valores em config.json (ver config.example.json).
# NUNCA coloque aqui a service_role key no deploy de um app estático.
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=sua-chave-anon-publica

# --- Geração de conteúdo em lote (só na sua máquina, não no deploy) ---
# GEMINI_API_KEY=AIza...
# OPENAI_API_KEY=sk-...
